{
  "jira": {
    "url": "https://yourcompany.atlassian.net",
    "email": "you@company.com",
    "projectKey": "PROJ"
  },
  "confluence": {
    "url": "https://yourcompany.atlassian.net",
    "spaceKey": "ENG"
  },
  "testSuite": {
    "type": "csv",
    "path": "./tests/regression_suite.csv",
    "columns": {
      "name": "Test Case Name",
      "area": "Feature Area",
      "priority": "Priority"
    }
  },
  "github": {
    "owner": "your-org",
    "repo": "your-repo",
    "apiBaseUrl": "https://api.github.com",
    "htmlBaseUrl": "https://github.com",
    "tokenEnv": "GITHUB_TOKEN",
    "allowedRepos": [],
    "maxRefs": 5,
    "maxFiles": 50,
    "maxPatchChars": 4000,
    "maxDiffChars": 60000
  },
  "llm": {
    "provider": "claude",
    "model": "claude-sonnet-4-6"
  },
  "output": {
    "format": "markdown",
    "saveReports": false,
    "reportsDir": "./ripple-reports"
  }
}
