ANTHROPIC_API_KEY=anthropic-api-key-placeholder
JIRA_API_TOKEN=jira-api-token-placeholder
CONFLUENCE_API_TOKEN=confluence-api-token-placeholder
# Serves two different features with two different scope needs:
#   - llm.provider "github" (GitHub Models) needs models:read
#   - ripple analyze --diff (code diff analysis) needs repo
# If those conflict, leave this one for GitHub Models and point the diff feature
# at a second token via "tokenEnv" in ripple.config.json's github block.
# Optional for public repositories (unauthenticated requests are 60/hour).
GITHUB_TOKEN=github-token-placeholder
OLLAMA_API_KEY=ollama
